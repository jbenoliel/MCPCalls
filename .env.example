# Credenciales NLPearl (no commitear el .env real)
PEARL_ACCOUNT_ID=
PEARL_SECRET_KEY=

# Pearl dedicado a MCPCalls
PEARL_OUTBOUND_ID=        # id de campana outbound en API v1 (make_call)
PEARL_ID=                 # id del Pearl en API v2 (consultas)

# Telefono real para llamadas de validacion de la Fase 0
PEARL_TEST_NUMBER=        # formato E.164, p.ej. +34600000000

# Receptor de webhooks (Fase 0: opcional, polling es la via principal)
MCPCALLS_WEBHOOK_TOKEN=   # token que Pearl adjunta a sus llamadas al webhook
WEBHOOK_PUBLIC_URL=       # URL publica (tunel) para registrar callWebhookUrl

# Persistencia y ventana horaria
MCPCALLS_DB_URL=sqlite:///./data/mcpcalls.db
MCPCALLS_CALLING_WINDOW=09:00-21:00 Europe/Madrid
